{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ElysiaApi",
  "mainBinaryName": "ElysiaApi",
  "version": "1.0.0",
  "identifier": "dev.pinkelysiadev.ElysiaApi",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: http: https:; media-src 'self' blob: http: https:; connect-src 'self' ipc: http://ipc.localhost http:; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "appimage"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/elysia-api"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxNjc0RURERjZBMUM3MTAKUldRUXg2SDIzVTVuOFVOd3RRUDRRekh4SUxsZGZaMXhoUWVyUGRIS1l6VHFWV2NFMUhiYWdBNzMK",
      "endpoints": [
        "https://github.com/PinkElysiaDev/Elysia-Api/releases/latest/download/latest.json"
      ]
    }
  }
}
